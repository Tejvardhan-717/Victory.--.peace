+        if VirtualProtect(at as *const _, new.len(), PAGE_EXECUTE_READWRITE, &mut old) == 0 {
+            return false;
+        }
+        std::ptr::copy_nonoverlapping(new.as_ptr(), at as *mut u8, new.len());
+        VirtualProtect(at as *const _, new.len(), old, &mut old);
+    }
