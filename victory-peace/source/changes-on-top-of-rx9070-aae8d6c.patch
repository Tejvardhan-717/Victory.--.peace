+/// Whether host copies of textures the title fills leave out their
+/// largest mips ([`reduce_by`]): only with `VICTORY_TEXTURES=reduced`. Grand Theft Auto VI's Series X profile has some 12 GB of such
+/// textures in the world: on a 6 GB card (5.1 GB budget) the card filled
+/// with 2 GB of them, the rest waited ("no room") and drew black.
+#[cfg(windows)]
+fn reduced_textures() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        // Opt-in: it lowers texture detail (the user's rule: quality trade-offs
+        // only when asked for).
+        let on = std::env::var("VICTORY_TEXTURES").is_ok_and(|v| v == "reduced");
