+/// Returns whether it was written.
+#[cfg(windows)]
+pub fn patch_code(at: usize, expected: &[u8], new: &[u8]) -> bool {
+    use windows_sys::Win32::System::Memory::{PAGE_EXECUTE_READWRITE, VirtualProtect};
+    if expected.len() != new.len() || new.is_empty() {
+        return false;
