 /// A view description from its words, with the format as the host has it.
+/// A shader view of a title texture as a view of its host copy that leaves
+/// out the `skip` largest mips (`resource::reduce_by`): the same mips where
+/// the copy has them, its largest for the ones it left out.
+fn skip_mips(d: &mut D3D12_SHADER_RESOURCE_VIEW_DESC, skip: u32) {
+    let shift = |most: &mut u32, levels: &mut u32, clamp: &mut f32| {
+        let gone = skip.saturating_sub(*most);
+        *most = most.saturating_sub(skip);
+        if *levels != u32::MAX {
+            *levels = levels.saturating_sub(gone).max(1);
+        }
+        *clamp = (*clamp - skip as f32).max(0.0);
+    };
+    // SAFETY: each arm uses the member the dimension names.
+    unsafe {
+        match d.ViewDimension {
+            D3D12_SRV_DIMENSION_TEXTURE2D => {
+                let v = &mut d.Anonymous.Texture2D;
+                shift(&mut v.MostDetailedMip, &mut v.MipLevels, &mut v.ResourceMinLODClamp);
+            }
+            D3D12_SRV_DIMENSION_TEXTURE2DARRAY => {
+                let v = &mut d.Anonymous.Texture2DArray;
+                shift(&mut v.MostDetailedMip, &mut v.MipLevels, &mut v.ResourceMinLODClamp);
+            }
+            D3D12_SRV_DIMENSION_TEXTURECUBE => {
+                let v = &mut d.Anonymous.TextureCube;
+                shift(&mut v.MostDetailedMip, &mut v.MipLevels, &mut v.ResourceMinLODClamp);
+            }
+            D3D12_SRV_DIMENSION_TEXTURECUBEARRAY => {
+                let v = &mut d.Anonymous.TextureCubeArray;
+                shift(&mut v.MostDetailedMip, &mut v.MipLevels, &mut v.ResourceMinLODClamp);
+            }
+            _ => {}
+        }
+    }
+}
