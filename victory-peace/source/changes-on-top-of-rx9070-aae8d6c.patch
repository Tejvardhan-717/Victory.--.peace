+/// Title mips a host copy of a texture with `desc` leaves out: none unless
+/// [`reduced_textures`] and the title fills it ([`fills`]); then for a 2D
+/// texture one from 512x512, two from 2048x2048, as far as it has mips and
+/// the size stays whole (block-compressed formats: a multiple of four).
+#[cfg(windows)]
+fn reduce_by(desc: &ResourceDesc) -> u32 {
+    const TEXTURE_2D: u32 = 3;
+    if !fills(desc) || desc.dimension != TEXTURE_2D || desc.sample_count > 1 || !reduced_textures() {
+        return 0;
+    }
+    let (w, h) = (desc.width, u64::from(desc.height));
+    let mips = u32::from(desc.mip_levels);
+    // Stronger steps (one from 256x256 to three from 4096x4096) saved only
+    // 240 MB more (1.54 GB against 1.78 GB) and made full-screen art
+    // visibly blocky: the card's budget goes to render targets (3.3 GB).
+    let want: u32 = if w * h >= 2048 * 2048 { 2 } else if w * h >= 512 * 512 { 1 } else { 0 };
+    let block: u64 = if matches!(pc_format(desc.format), 70..=84 | 94..=99) { 4 } else { 1 };
+    (0..=want.min(mips.saturating_sub(1)))
+        .rev()
+        .find(|&k| w % (block << k) == 0 && h % (block << k) == 0)
+        .unwrap_or(0)
+}
